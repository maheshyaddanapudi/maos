{
  "permissions": [
    "Bash(pytest *)",
    "Bash(python *)",
    "Bash(pip install *)",
    "Bash(ruff *)",
    "Bash(mypy *)",
    "Bash(maos *)",
    "Bash(git status)",
    "Bash(git diff *)",
    "Bash(git log *)",
    "Bash(git branch *)",
    "Bash(git add *)",
    "Bash(git commit *)",
    "Bash(git push *)"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "command": "ruff check --fix --quiet $CLAUDE_FILE_PATH 2>/dev/null || true"
      }
    ]
  }
}
