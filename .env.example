# MAOS Environment Variables
# Copy to .env and fill in values

# =============================================================================
# LLM Provider API Keys (set the ones you need)
# =============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Azure OpenAI (if using azure_openai provider)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01

# =============================================================================
# PostgreSQL (if using postgres checkpointer)
# =============================================================================
# MAOS_POSTGRES_URI=postgresql://user:pass@localhost:5432/maos

# =============================================================================
# MAOS Configuration
# =============================================================================
# MAOS_CONFIG=config.yaml
